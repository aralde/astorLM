{
  "name": "astorlm",
  "version": "0.2.3",
  "description": "The agent loop as a library: an embeddable, SDK-first agentic runtime for TypeScript.",
  "type": "module",
  "author": "Aralde <aralde.git@gmail.com> (https://github.com/aralde)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aralde/astorLM.git"
  },
  "homepage": "https://aralde.github.io/astorLM/",
  "bugs": {
    "url": "https://github.com/aralde/astorLM/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.cjs"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.js",
      "require": "./dist/prompt/index.cjs"
    },
    "./embeddings": {
      "types": "./dist/embeddings/index.d.ts",
      "import": "./dist/embeddings/index.js",
      "require": "./dist/embeddings/index.cjs"
    },
    "./experimental/error-registry": {
      "types": "./dist/experimental/error-registry/index.d.ts",
      "import": "./dist/experimental/error-registry/index.js",
      "require": "./dist/experimental/error-registry/index.cjs"
    },
    "./experimental/contract": {
      "types": "./dist/experimental/contract/index.d.ts",
      "import": "./dist/experimental/contract/index.js",
      "require": "./dist/experimental/contract/index.cjs"
    },
    "./experimental/edge-boost": {
      "types": "./dist/experimental/edge-boost/index.d.ts",
      "import": "./dist/experimental/edge-boost/index.js",
      "require": "./dist/experimental/edge-boost/index.cjs"
    },
    "./experimental/wasm-runner": {
      "types": "./dist/experimental/wasm-runner/index.d.ts",
      "import": "./dist/experimental/wasm-runner/index.js",
      "require": "./dist/experimental/wasm-runner/index.cjs"
    },
    "./experimental/tracing": {
      "types": "./dist/experimental/tracing/index.d.ts",
      "import": "./dist/experimental/tracing/index.js",
      "require": "./dist/experimental/tracing/index.cjs"
    },
    "./experimental/tracing/otel": {
      "types": "./dist/experimental/tracing/otel/index.d.ts",
      "import": "./dist/experimental/tracing/otel/index.js",
      "require": "./dist/experimental/tracing/otel/index.cjs"
    },
    "./experimental/metrics": {
      "types": "./dist/experimental/metrics/index.d.ts",
      "import": "./dist/experimental/metrics/index.js",
      "require": "./dist/experimental/metrics/index.cjs"
    },
    "./experimental/replay": {
      "types": "./dist/experimental/replay/index.d.ts",
      "import": "./dist/experimental/replay/index.js",
      "require": "./dist/experimental/replay/index.cjs"
    },
    "./experimental/evals": {
      "types": "./dist/experimental/evals/index.d.ts",
      "import": "./dist/experimental/evals/index.js",
      "require": "./dist/experimental/evals/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agent",
    "llm",
    "anthropic",
    "mcp",
    "coding-agent",
    "sdk"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.17.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "quickjs-emscripten": "^0.32.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "quickjs-emscripten": "^0.32.0"
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=20"
  }
}
