{
  "name": "astorlm",
  "version": "0.1.0",
  "description": "Embeddable agentic coding library (SDK-first). Inspired by @earendil-works/pi-coding-agent.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./tools/node": {
      "types": "./dist/tools/node.d.ts",
      "import": "./dist/tools/node.js",
      "require": "./dist/tools/node.cjs"
    },
    "./experimental/error-registry": {
      "types": "./dist/experimental/error-registry/index.d.ts",
      "import": "./dist/experimental/error-registry/index.js",
      "require": "./dist/experimental/error-registry/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["agent", "llm", "anthropic", "mcp", "coding-agent", "sdk"],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "openai": "^4.77.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
